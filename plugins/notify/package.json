  "description": "DSH Business Bridge plugin bridge-notify: IM notifications (recipients from the business API, realtime digest, quiet hours, AI secretary framing, scheduled reports, audience delivery)",
  "type": "module",
  "main": "src/index.js",
  "exports": {
