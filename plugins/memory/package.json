  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Biz Assistant Framework plugin bridge-memory: long-term memory for AI employees (personal memory per employee, shared organization memory, conversation recall), personal-data checked before saving",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
