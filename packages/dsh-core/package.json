{
  "name": "@dsh-bridge/dsh-core",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "DSH Business Bridge — DSH side core: application registry, manifest holder, per-application business API client, delegation cache, session keys, tools-sdk, app-switch, secretary framing, delivery classification (and the bridge-apps DSH plugin)",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tools-sdk": "./src/tools-sdk.js",
    "./runtime": "./src/runtime.js",
    "./api": "./src/api-client.js",
    "./registry": "./src/registry.js",
    "./app-switch": "./src/app-switch.js",
    "./apps": "./src/apps.js",
    "./secretary": "./src/secretary.js",
    "./persona": "./src/persona.js",
    "./ai-profile": "./src/ai-profile.js",
    "./link-guard": "./src/link-guard.js",
    "./help-tool": "./src/help-tool.js",
    "./delivery": "./src/delivery.js",
    "./outbound": "./src/outbound.js",
    "./session": "./src/session.js",
    "./manifest": "./src/manifest.js",
    "./delegation": "./src/delegation.js",
    "./plugin": "./src/plugin.js",
    "./compat/care-billing-paths": "./src/compat/care-billing-paths.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@dsh-bridge/protocol": "*"
  },
  "devDependencies": {
    "@dsh-bridge/protocol": "workspace:*"
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs"
  }
}
